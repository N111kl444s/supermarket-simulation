    "map_select": "Switches the map layout, routes, and areas.",
    "time_control": "Sets the store opening and closing times.",
    "customer_volume": "Customer arrivals follow exponential inter-arrival times. Formula: f(t)=λ·e^{-λt}, λ=1/μ.",
    "share_disabled": "Share of customers with disabilities (in %).",
    "speed": "Gaussian distribution with mean (Ø) and standard deviation (σ). Formula: f(x)=1/(σ√(2π))·exp(-(x-μ)^2/(2σ^2)).",
    "cart": "Target number of items (normal distribution). Formula: f(x)=1/(σ√(2π))·exp(-(x-μ)^2/(2σ^2)).",
    "hand_scanner": "With handheld scanner, only one scan at the checkout is needed.",
    "scan": "Time per item (uniform between min and max). Formula: f(x)=1/(b-a), a≤x≤b.",
    "payment": "Sets the probability for cash/card (sum 100%).",
    "cashier": "Staff scanning speed (uniform distribution). Formula: f(x)=1/(b-a), a≤x≤b.",
    "paytime": "Payment duration at normal checkouts (uniform). Formula: f(x)=1/(b-a), a≤x≤b.",
    "paytime_sb": "Payment duration at self-checkouts (uniform). Formula: f(x)=1/(b-a), a≤x≤b.",
    "conflict": "Time until a conflict is resolved (uniform). Formula: f(x)=1/(b-a), a≤x≤b.",
